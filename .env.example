# Copy this file to .env and fill in your key.  (.env is git-ignored.)
GROQ_API_KEY=your_groq_key_here

# Optional settings
GROQ_MODEL=openai/gpt-oss-120b
CHROMA_PATH=./chroma_db
MEMORY_MAX_DISTANCE=1.5
MAX_STEPS=5

# Multi-agent research team (research.py)
TEAM_MODEL=openai/gpt-oss-120b
TEAM_MAX_CONCURRENCY=3
RESEARCHER_TIMEOUT=120
RESEARCHER_MAX_STEPS=4
MAX_REVISIONS=1
